<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `mise run upload-night` (the valley's finished tile pyramids to R2, at an easy pace,
  until 5:00) every day at 22:00. Install and remove it with `mise run schedule-on` and
  `mise run schedule-off`; don't edit the copy in ~/Library/LaunchAgents. If the Mac is
  asleep at 22:00, launchd runs it when the Mac next wakes, and the task does nothing outside
  22:00 to 5:00. caffeinate keeps the Mac from dozing off until the run is finished.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oinam.manipur.upload</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/brajeshwar/.local/bin/mise</string>
    <string>run</string>
    <string>upload-night</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/brajeshwar/dev/manipur</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/brajeshwar/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/brajeshwar/dev/manipur/logs/upload-night.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brajeshwar/dev/manipur/logs/upload-night.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
