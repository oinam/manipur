# Copy to .env and fill in. mise loads .env in this folder; git ignores it.

# OpenSky Network API client, optional, for the private coverage logger only
# (tools/log_aircraft.py). The site does not use OpenSky (docs/AIRCRAFT.md).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# RapidAPI key with AeroDataBox's Basic plan, for the timetable; the Worker secret of
# the same name must match.
AERODATABOX_KEY=

# R2 API token with Object Read & Write on the manipur-tiles bucket only, for
# tools/upload_tiles.py. Make one in the Cloudflare dashboard: R2, Manage API tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
