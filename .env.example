# Copy to .env and fill in. mise loads .env in this folder; git ignores it.

# OpenSky Network API client, for live aircraft (docs/AIRCRAFT.md).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Lets `mise run relay` post planes to the site; the Worker secret RELAY_TOKEN must match.
# Make one with `openssl rand -hex 32`.
RELAY_TOKEN=

# RapidAPI key with AeroDataBox's Basic plan, for the timetable; the Worker secret of
# the same name must match.
AERODATABOX_KEY=
